# Task Fabric SVN — environment template.
# Copy to .env and fill in. Never commit .env (it is gitignored).

# Config path override (default: ~/.config/task-fabric-svn/).
TASK_FABRIC_SVN_WORK_CONFIG=

# Inference router key injected by the per-task proxy (see config/experiment-opencode.json).
NINEROUTER_KEY=

# Router API key the proxy requires at startup — fail-closed when unset.
TASK_FABRIC_SVN_9ROUTER_API_KEY=
